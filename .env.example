APP_NAME="NEXUS-FIELD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
# Fuso da operacao. O padrao acompanha o horario do MySQL local (SYSTEM); em
# outro servidor mantenha os dois no mesmo fuso para as leituras de data baterem.
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados: MySQL local (WAMP) 127.0.0.1:3306, schema "nexusfield".
# O legado foi preservado em "nexusfield_legacy" e nao e usado por esta aplicacao.
# Em producao use usuario proprio e senha forte; nunca reutilize root sem senha.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexusfield
DB_USERNAME=root
DB_PASSWORD=
# InnoDB e obrigatorio: chave estrangeira e transacao nao existem em MyISAM.
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nexusfield.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Credenciais do administrador criado pelo seeder. Em producao o seeder
# recusa senha gerada automaticamente: defina um valor forte antes de semear.
SEED_ADMIN_EMAIL=admin@nexusfield.local
SEED_ADMIN_PASSWORD=
# Senha dos usuarios da empresa de demonstracao (DemoSeeder). Nao e usada pela
# empresa real. Sem valor, o seeder gera uma senha e mostra no console.
SEED_DEMO_PASSWORD=
