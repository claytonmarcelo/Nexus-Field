APP_NAME="NEXUS-FIELD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
# Fuso da operacao. O padrao acompanha o horario do MySQL local (SYSTEM); em
# outro servidor mantenha os dois no mesmo fuso para as leituras de data baterem.
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados: MySQL local (WAMP) 127.0.0.1:3306, schema "nexusfield".
# O legado foi preservado em "nexusfield_legacy" e nao e usado por esta aplicacao.
# Em producao use usuario proprio e senha forte; nunca reutilize root sem senha.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexusfield
DB_USERNAME=root
DB_PASSWORD=
# InnoDB e obrigatorio: chave estrangeira e transacao nao existem em MyISAM.
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nexusfield.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Conta raiz do sistema: o administrador permanente do projeto. Tem o catalogo
# inteiro de permissoes, nao pode ser excluido, desativado, ter email ou empresa
# trocados nem perder a condicao de raiz -- a guarda fica no model, nao na tela. O
# endereco antigo (aposentado por seguranca) esta em DatabaseSeeder::RETIRED_ROOT_EMAIL
# e o seeder recusa semear nele. Em producao o seeder recusa senha gerada
# automaticamente: defina um valor forte antes de semear.
SEED_ADMIN_EMAIL=admin@nexusfield.example
# Senha da conta raiz. Se contiver "#", escreva entre aspas: sem aspas o dotenv le
# o "#" como inicio de comentario e a senha chega truncada ao seeder.
SEED_ADMIN_PASSWORD=
# Senha dos usuarios da empresa de demonstracao (DemoSeeder). Nao e usada pela
# empresa real. Sem valor, o seeder gera uma senha e mostra no console.
SEED_DEMO_PASSWORD=

# Armazenamento de arquivos. O padrao local atende a marca da empresa; para
# producao, troque para s3 e preencha o bucket abaixo. AWS_ENDPOINT permite
# provedores compativeis (R2, MinIO); use aspas se a senha tiver "#".
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# IA (Laravel AI SDK) — preencha apenas o provedor que sera usado. Chave vazia
# significa que aquele provedor nao deve ser chamado; nenhuma chave entra no git.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
# OPENAI_COMPATIBLE_URL=
# OPENAI_COMPATIBLE_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=

# ---------------------------------------------------------------------------
# Vercel / Container Runtime — production
#
# Defina estas variáveis no projeto da Vercel (Production), nunca neste arquivo
# versionado. Os valores abaixo são apenas os nomes das variáveis: nenhuma
# credencial, chave ou senha deve ser escrita aqui.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://seu-dominio.com
# APP_KEY=base64:gerada-com-php-artisan-key-generate
# TRUSTED_PROXIES=IP_DO_PROXY_1,IP_DO_PROXY_2
# Nunca use *: qualquer visitante poderia forjar X-Forwarded-For e burlar o throttle.
# TRUSTED_HOSTS são expressões regulares PCRE, não nomes de domínio.
# TRUSTED_HOSTS=^.*\.vercel\.app$
# LOG_CHANNEL=stderr
# LOG_STACK=stderr
# LOG_LEVEL=info
# SESSION_SECURE_COOKIE=true
# SESSION_DRIVER=cookie
# CACHE_STORE=file
# APP_MAINTENANCE_DRIVER=cache
# CRON_SECRET=valor-aleatorio-longo-sem-caracteres-especiais
#
# E-mail transacional é obrigatório para "recuperar senha". Use smtp (qualquer
# provedor) ou resend (mailer nativo do Laravel). MAIL_MAILER=log só serve para
# desenvolvimento: em produção o link ficaria preso no log e o usuário nunca
# receberia a mensagem.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.seu-provedor.com
# MAIL_PORT=587
# MAIL_USERNAME=seu-usuario
# MAIL_PASSWORD=sua-senha-de-app
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=no-reply@seu-dominio.com
# MAIL_FROM_NAME="${APP_NAME}"
#
# A conta raiz é criada pelo seeder. Defina SEED_ADMIN_EMAIL e
# SEED_ADMIN_PASSWORD no ambiente de deploy antes de rodar o seed. Se a senha
# contiver "#", escreva-a entre aspas no .env local; na Vercel use o campo
# de variável de ambiente, que não interpreta "#" como comentário.
#
# Banco externo de producao: TiDB Cloud (MySQL-compatible).
# DB_CONNECTION=mysql
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=nexus_db
# DB_USERNAME=usuario_do_cluster
# DB_PASSWORD=senha_do_cluster
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# O endpoint publico do TiDB exige TLS; o bundle de CAs ja esta na imagem.
# Na Vercel, SESSION_DRIVER=cookie tira a sessao do banco remoto e
# CACHE_STORE=file deixa o cache curto do painel em APP_STORAGE_PATH. Local e
# testes continuam com database para os dois. FILESYSTEM_DISK=local enquanto
# nao houver credenciais S3; FILESYSTEM_DISK=s3 com AWS_* preenchidos.
